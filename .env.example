# Port the server listens on. Railway injects this automatically -- you
# normally don't need to set it yourself.
PORT=8080

# Railway Bucket connection info (S3-compatible). In your Railway project:
# add a Bucket, then on this service go to Variables -> "Connect Service to
# Bucket" -> pick the bucket -> style "AWS SDK (Generic)" -> Add Variables.
# That writes exactly these 5 variables for you -- nothing to copy by hand.
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: require `Authorization: Bearer <token>` on every request to
# /mcp. Strongly recommended once this is deployed publicly. Leave unset
# for local development.
MCP_API_KEY=
