# Port the server listens on. Railway injects this automatically -- you
# normally don't need to set it yourself.
PORT=8080

# Railway Bucket connection info (S3-compatible). Create a bucket in your
# Railway project and copy these from its "Connect" tab.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=auto

# Optional: require `Authorization: Bearer <token>` on every request to
# /mcp. Strongly recommended once this is deployed publicly. Leave unset
# for local development.
MCP_API_KEY=
